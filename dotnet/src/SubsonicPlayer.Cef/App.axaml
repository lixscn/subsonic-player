<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SubsonicPlayer.App"
             xmlns:local="using:SubsonicPlayer"
             xmlns:semi="https://irihi.tech/semi"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Semi 主题色覆盖为「播放绿」（不随主题变） -->
        <SolidColorBrush x:Key="SemiColorPrimary" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#4ADE80"/>
        <SolidColorBrush x:Key="SemiColorPrimaryActive" Color="#16A34A"/>
        <SolidColorBrush x:Key="SemiColorPrimaryDisabled" Color="#14532D"/>
        <SolidColorBrush x:Key="SemiColorPrimaryLight" Opacity="0.2" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorPrimaryLightPointerover" Opacity="0.3" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorPrimaryLightActive" Opacity="0.4" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorFocusBorder" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorLink" Color="#22C55E"/>
        <SolidColorBrush x:Key="SemiColorLinkPointerover" Color="#4ADE80"/>
        <SolidColorBrush x:Key="SemiColorLinkActive" Color="#16A34A"/>
        <SolidColorBrush x:Key="SemiColorLinkVisited" Color="#22C55E"/>

        <!-- 强调色（不随主题变） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#16A34A"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F22C55E"/>

        <!-- 随主题变化的配色（默认深色，浅色由 App.ApplyTheme 动态替换） -->
        <SolidColorBrush x:Key="BgAppBrush" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="BgSurfaceBrush" Color="#121216"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="#1A1A1F"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="#222228"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A33"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9C9CA6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6B76"/>
        <SolidColorBrush x:Key="OverlayBrush" Color="#7A0A0A0C"/>
        <SolidColorBrush x:Key="ShadowBrush" Color="#40000000"/>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />

        <!-- 占位块（封面/图标占位） -->
        <Style Selector="Border.wf">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- 卡片 -->
        <Style Selector="Border.wf-card">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.wf-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
        </Style>
        <!-- 标题 -->
        <Style Selector="TextBlock.wf-title">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- 次级文字 -->
        <Style Selector="TextBlock.wf-sub">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 占位文字 -->
        <Style Selector="TextBlock.wf-placeholder">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 透明点击按钮（用于列表项点击播放） -->
        <Style Selector="Button.transparent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- 列表项去除默认内边距，保证与表头对齐 -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Application.Styles>
</Application>
