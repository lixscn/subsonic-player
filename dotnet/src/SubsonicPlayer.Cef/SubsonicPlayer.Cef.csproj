<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <RootNamespace>SubsonicPlayer</RootNamespace>
    <AssemblyName>SubsonicPlayer</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">Assets\avalonia-logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <NativeDir Condition="$(RuntimeIdentifier.StartsWith('win'))">native\win-x64</NativeDir>
    <NativeDir Condition="$(RuntimeIdentifier.StartsWith('osx'))">native\osx</NativeDir>
    <NativeDir Condition="$(RuntimeIdentifier.StartsWith('linux'))">native\linux-$(RuntimeIdentifier.Substring(6))</NativeDir>
    <NativeDir Condition="'$(NativeDir)' == '' and '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">native\win-x64</NativeDir>
    <NativeDir Condition="'$(NativeDir)' == '' and '$(TargetFramework)' == 'net10.0' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">native\osx</NativeDir>
    <NativeDir Condition="'$(NativeDir)' == '' and '$(TargetFramework)' == 'net10.0' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">native\linux-x64</NativeDir>
    <NativeDir Condition="'$(NativeDir)' == '' and '$(TargetFramework)' == 'net10.0' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">native\win-x64</NativeDir>
    <!-- CefGlue.Common.props 会注入多平台 RuntimeIdentifiers，与 windows10.0 TFM 冲突（NETSDK1082），这里覆盖清空；跨平台打包走 publish.ps1 的 -r 参数 -->
    <RuntimeIdentifiers></RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubsonicPlayer.Core\SubsonicPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="$(NativeDir)\*" Condition="'$(NativeDir)' != ''">
      <Link>lib\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- WebAssets 内嵌为程序集资源（AppUI.*），app:// 服务从资源读取，部署无需 WebAssets 目录 -->
    <EmbeddedResource Include="WebAssets\index.html" LogicalName="AppUI.index.html" />
    <EmbeddedResource Include="WebAssets\styles.css" LogicalName="AppUI.styles.css" />
    <EmbeddedResource Include="WebAssets\app.js" LogicalName="AppUI.app.js" />
    <EmbeddedResource Include="WebAssets\mini.html" LogicalName="AppUI.mini.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Semi.Avalonia" Version="11.3.14" />
    <PackageReference Include="CefGlue.Avalonia" Version="120.6099.211" />
    <PackageReference Include="CefGlue.Common" Version="120.6099.211" />
  </ItemGroup>

  <!-- CefGlue.Common 包只把 Xilium.CefGlue.dll 当运行时资产，不暴露编译引用；这里显式引用（含 CefSettings 类型） -->
  <ItemGroup>
    <Reference Include="Xilium.CefGlue">
      <HintPath>$(NuGetPackageRoot)cefglue.common\120.6099.211\lib\net8.0\Xilium.CefGlue.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 修复 Avalonia 增量构建偶发跳过 XAML 资源生成、导致运行时报 "No precompiled XAML" 的问题：每次构建前删除旧资源文件强制重生成 -->
  <Target Name="ForceAvaloniaResourcesRegeneration" BeforeTargets="GenerateAvaloniaResources">
    <Delete Files="$(IntermediateOutputPath)Avalonia\resources" Condition="Exists('$(IntermediateOutputPath)Avalonia\resources')" />
  </Target>

</Project>