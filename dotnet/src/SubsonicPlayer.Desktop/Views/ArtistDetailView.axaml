<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SubsonicPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SubsonicPlayer.Views.ArtistDetailView"
             x:DataType="vm:ArtistDetailViewModel">
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <Button Content="返回" Command="{Binding BackCommand}" HorizontalAlignment="Left"/>

            <!-- 大横幅卡片 -->
            <Border Classes="wf-card" CornerRadius="12" Padding="28" Margin="0,4,0,8">
                <Grid ColumnDefinitions="180,*,Auto">
                    <Border Width="180" Height="180" CornerRadius="90" Background="{DynamicResource BgCardBrush}" ClipToBounds="True">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,0" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatsText}" Classes="wf-sub" FontSize="15"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="播放全部" Command="{Binding PlayAllCommand}" Padding="20,10" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 最新专辑网格 -->
            <TextBlock Text="最新专辑" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,8"/>
            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumItemViewModel">
                        <Button Classes="transparent" Command="{Binding OpenDetailCommand}">
                            <StackPanel Width="160" Margin="8" Spacing="8">
                                <Border Width="160" Height="160" CornerRadius="8" Background="{DynamicResource BgCardBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                <TextBlock Text="{Binding Artist}" Classes="wf-sub" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>