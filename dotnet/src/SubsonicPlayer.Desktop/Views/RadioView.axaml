<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SubsonicPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SubsonicPlayer.Views.RadioView"
             x:DataType="vm:RadioViewModel">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="互联网电台" Classes="wf-title" Margin="0,0,0,16"/>
        <TextBlock Text="{Binding Status}" Classes="wf-sub" IsVisible="{Binding HasStatus}"/>
    </DockPanel>
</UserControl>
