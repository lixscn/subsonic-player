<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SubsonicPlayer.ViewModels"
             xmlns:models="using:SubsonicPlayer.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SubsonicPlayer.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">
    <Grid ColumnDefinitions="300,*,320" Margin="24">

        <!-- 左：封面 + 曲目信息 + 进度 -->
        <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center">
            <Border Width="240" Height="240" CornerRadius="8" Background="{DynamicResource BgCardBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                <Image Source="{Binding Playback.CurrentCover}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center" MaxWidth="280">
                <TextBlock Text="{Binding Playback.CurrentTitle}" FontSize="20" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Playback.CurrentSong.Artist}" Classes="wf-sub" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Width="280" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Playback.PositionText}" Classes="wf-sub" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="{Binding Playback.DurationSeconds, FallbackValue=1}" Value="{Binding Playback.PositionSeconds}"/>
                <TextBlock Grid.Column="2" Text="{Binding Playback.DurationText}" Classes="wf-sub" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- 中：歌词（主流沉浸式：当前行居中放大高亮 + 前后行渐隐 + 平滑滚动） -->
        <Border Grid.Column="1" Padding="16" Margin="0,0,12,0">
            <Grid>
                <TextBlock Text="{Binding LyricsStatus}" Classes="wf-sub" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding HasLyricsStatus}"/>

                <!-- 非同步歌词 -->
                <ScrollViewer IsVisible="{Binding Lyrics.IsSynced, Converter={x:Static conv:BoolConverters.Not}, FallbackValue=False}">
                    <TextBlock Text="{Binding LyricsText}" TextWrapping="Wrap" LineHeight="26" FontSize="15" TextAlignment="Center"/>
                </ScrollViewer>

                <!-- 同步歌词：主流卡拉 OK 式（当前行放大高亮 + 前后行渐隐 + 滚动居中） -->
                <ListBox x:Name="LyricsList" ItemsSource="{Binding Lyrics.Lines}"
                         SelectedIndex="{Binding CurrentLineIndex, Mode=OneWay}"
                         Background="Transparent"
                         IsVisible="{Binding Lyrics.IsSynced, FallbackValue=False}"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         HorizontalAlignment="Stretch">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0,14"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontSize" Value="19"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Opacity" Value="1"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LyricsLine">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右：播放队列 -->
        <Border Grid.Column="2" Classes="wf-card" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="播放队列" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox x:Name="QueueList" ItemsSource="{Binding Playback.QueueItems}"
                         SelectedIndex="{Binding Playback.CurrentIndex, Mode=OneWay}"
                         Background="Transparent">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SongItemViewModel">
                            <Grid>
                                <Border Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Top" Margin="0,-1,0,0"
                                        IsVisible="{Binding IsDropIndicator}"/>
                                <Border Background="Transparent"
                                        PointerPressed="OnQueueItemPressed"
                                        PointerMoved="OnQueueItemMoved"
                                        PointerReleased="OnQueueItemReleased"
                                        Padding="4">
                                    <Grid ColumnDefinitions="36,160,40,22">
                                    <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource BgCardBrush}" ClipToBounds="True" VerticalAlignment="Center">
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Grid Grid.Column="1" Margin="8,0" RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Artist}" Classes="wf-sub" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="wf-sub" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <Button Grid.Column="3" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding ToggleFavoriteCommand}" ToolTip.Tip="收藏" VerticalAlignment="Center">
                                        <Grid>
                                            <Path Data="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" IsVisible="{Binding IsFavorite, Converter={x:Static conv:BoolConverters.Not}}"/>
                                            <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" IsVisible="{Binding IsFavorite}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
