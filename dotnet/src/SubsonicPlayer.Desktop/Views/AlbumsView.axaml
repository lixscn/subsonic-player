<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SubsonicPlayer.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SubsonicPlayer.Views.AlbumsView"
             x:DataType="vm:AlbumsViewModel">
    <UserControl.Styles>
        <!-- 悬浮卡片显示播放按钮 -->
        <Style Selector="Border.album-hover Button.play-reveal">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.album-hover:pointerover Button.play-reveal">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Border.album-hover:pointerover Image.cover-dim">
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="专辑" Classes="wf-title"/>
                <Button Content="网格 / 列表" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" Classes="wf-sub" IsVisible="{Binding HasStatus}"/>
            <ItemsControl ItemsSource="{Binding Albums}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumItemViewModel">
                        <Button Classes="transparent" Command="{Binding OpenDetailCommand}">
                            <StackPanel Width="160" Margin="8" Spacing="8">
                                <Border Classes="album-hover" Width="160" Height="160" CornerRadius="8" Background="{DynamicResource BgCardBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Image Classes="cover-dim" Source="{Binding Cover}" Stretch="UniformToFill"/>
                                        <Button Classes="transparent play-reveal" Command="{Binding PlayCommand}"
                                                Width="160" Height="160" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                            <Border Width="48" Height="48" CornerRadius="24" Background="#990E0E11">
                                                <Path Data="M8 5v14l11-7z" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                <TextBlock Text="{Binding Artist}" Classes="wf-sub" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}"/>
                <TextBlock Text="{Binding PageInfo}" Classes="wf-sub" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PageInput}" Width="40" VerticalAlignment="Center"/>
                <Button Content="跳转" Command="{Binding JumpPageCommand}"/>
                <Button Content="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>