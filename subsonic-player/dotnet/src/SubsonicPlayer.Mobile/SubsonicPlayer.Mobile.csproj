<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Mobile 占位工程（P6）。
    需要先安装 workload：dotnet workload install android ios
    编译：dotnet build -f net10.0-android / net10.0-ios
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <RootNamespace>SubsonicPlayer</RootNamespace>
    <AssemblyName>SubsonicPlayer.Mobile</AssemblyName>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubsonicPlayer.Core\SubsonicPlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 版本与 Core/Cef 统一（11.3.20 / Semi 11.3.14），避免 Mobile 引用 Core 时的 Avalonia 版本冲突（NuGet 统一到 12 会崩）。
         说明：Avalonia 11.3.20 已支持 Android/iOS，移动端无需依赖 12 专有特性。 -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <PackageReference Include="Semi.Avalonia" Version="11.3.14" />
  </ItemGroup>

</Project>