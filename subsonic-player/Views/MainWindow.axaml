<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SubsonicPlayer.ViewModels"
        xmlns:views="using:SubsonicPlayer.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:models="using:SubsonicPlayer.Models"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="SubsonicPlayer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Subsonic 音乐播放器"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="56"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource BgAppBrush}"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="640"
        KeyDown="OnKeyDown">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <!-- 封面主色渐变背景（随当前曲目封面主色变化） -->
        <Border Background="{Binding BackgroundBrush}"/>
        <!-- 遮罩，保证前景文字可读（随主题变化） -->
        <Border Background="{DynamicResource OverlayBrush}"/>

    <DockPanel>

        <!-- 顶栏（可拖动标题栏） -->
        <Border DockPanel.Dock="Top" Height="56" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" PointerPressed="OnTitleBarPressed" DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="10" Height="10" Background="{StaticResource AccentBrush}" CornerRadius="5"/>
                    <TextBlock Text="Subsonic Player" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBox Grid.Column="1" PlaceholderText="搜索歌曲 / 专辑 / 艺术家" MaxWidth="480" Margin="24,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="服务器未配置" Classes="wf-sub" VerticalAlignment="Center"/>
                    <Button Content="切换服务器"/>
                </StackPanel>
                <Button Grid.Column="3" Content="设置" Command="{Binding OpenSettingsCommand}" Margin="12,0"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnMinimizeClick" Padding="14,0" Height="56" Background="Transparent" BorderThickness="0">
                        <Path Data="M6 11h12v2H6z" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Click="OnMaximizeClick" Padding="14,0" Height="56" Background="Transparent" BorderThickness="0">
                        <Path Data="M6 6h12v12H6z" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Button Click="OnCloseClick" Padding="14,0" Height="56" Background="Transparent" BorderThickness="0">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部播放栏 -->
        <Border DockPanel.Dock="Bottom" Height="88" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="300,*,320" Margin="16,0">
                <!-- 左：封面 + 曲目信息 -->
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="4" Background="{DynamicResource BgCardBrush}" ClipToBounds="True">
                        <Image Source="{Binding Playback.CurrentCover}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="160">
                        <TextBlock Text="{Binding Playback.CurrentTitle}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Playback.CurrentSong.Artist}" Classes="wf-sub" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Content="收藏" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 中：控制 + 进度 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" VerticalAlignment="Center">
                        <Button Command="{Binding Playback.PreviousCommand}" ToolTip.Tip="上一首" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="{DynamicResource TextPrimaryBrush}" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding Playback.PlayPauseCommand}" ToolTip.Tip="播放 / 暂停" Background="{StaticResource AccentBrush}" CornerRadius="20" Width="40" Height="40" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid>
                                <Path Data="M8 5v14l11-7z" Fill="#0E0E11" Width="18" Height="18" Stretch="Uniform"
                                      IsVisible="{Binding Playback.IsPlaying, Converter={x:Static conv:BoolConverters.Not}}"/>
                                <Path Data="M6 5h4v14H6zM14 5h4v14h-4z" Fill="#0E0E11" Width="18" Height="18" Stretch="Uniform"
                                      IsVisible="{Binding Playback.IsPlaying}"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding Playback.NextCommand}" ToolTip.Tip="下一首" Width="40" Height="40" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Path Data="M6 18l8.5-6L6 6v12zM16 6h2v12h-2z" Fill="{DynamicResource TextPrimaryBrush}" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding Playback.PositionText}" Classes="wf-sub" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                Minimum="0" Maximum="{Binding Playback.DurationSeconds, FallbackValue=1}"
                                Value="{Binding Playback.PositionSeconds}"
                                PointerReleased="OnProgressReleased"/>
                        <TextBlock Grid.Column="2" Text="{Binding Playback.DurationText}" Classes="wf-sub" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- 右：模式 / 音效 / 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="歌词">
                        <Path Data="M20.41 8.41l-4.83-4.83c-.37-.37-.88-.58-1.41-.58H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V9.83c0-.53-.21-1.04-.59-1.42zM7 7h7v2H7V7zm10 10H7v-2h10v2zm0-4H7v-2h10v2z" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border Padding="12"><TextBlock Text="当前服务不支持歌词"/></Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="播放队列">
                        <Path Data="M4 10h12v2H4zm0-4h12v2H4zm0 8h8v2H4zm10 0v6l5-3z" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Border Classes="wf-card" Padding="8" MaxHeight="320">
                                    <ListBox ItemsSource="{Binding Playback.Queue}" Background="Transparent" MaxWidth="280">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Song">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="4,2"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="均衡器">
                        <Path Data="M10 20h4V4h-4v16zm-6 0h4v-8H4v8zM16 9v11h4V9h-4z" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <views:EqPanelView DataContext="{Binding EqPanel}"/>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding Playback.TogglePlayModeCommand}" ToolTip.Tip="{Binding Playback.PlayModeName}">
                        <Path Data="{Binding Playback.PlayModeIcon}" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTip.Tip="睡眠定时器">
                        <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Fill="{DynamicResource TextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <StackPanel Spacing="4">
                                    <Button Content="关闭" Command="{Binding Playback.SetSleepTimerCommand}" CommandParameter="0"/>
                                    <Button Content="15 分钟" Command="{Binding Playback.SetSleepTimerCommand}" CommandParameter="15"/>
                                    <Button Content="30 分钟" Command="{Binding Playback.SetSleepTimerCommand}" CommandParameter="30"/>
                                    <Button Content="60 分钟" Command="{Binding Playback.SetSleepTimerCommand}" CommandParameter="60"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Slider Width="80" VerticalAlignment="Center" Minimum="0" Maximum="1"
                            Value="{Binding Playback.Volume, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体 -->
        <Grid ColumnDefinitions="200,*">

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="12">
                        <Button Content="{Binding ThemeName}" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Stretch"/>
                        <Button Content="设置" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             Background="Transparent"
                             Margin="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <TextBlock Text="{Binding Label}" Padding="10,8"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 主内容区 -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        </Grid>
    </DockPanel>
    </Grid>

</Window>
