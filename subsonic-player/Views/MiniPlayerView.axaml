<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="96"
             x:Class="SubsonicPlayer.Views.MiniPlayerView">
    <Border Classes="wf-card" Padding="12">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <Border Width="56" Height="56" Classes="wf"/>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="曲目标题" FontSize="14"/>
                <TextBlock Text="艺术家" Classes="wf-sub"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Padding="6">
                    <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
                <Button Background="{StaticResource AccentBrush}" CornerRadius="16" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Path Data="M8 5v14l11-7z" Fill="#0E0E11" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <Button Padding="6">
                    <Path Data="M6 18l8.5-6L6 6v12zM16 6h2v12h-2z" Fill="{DynamicResource TextPrimaryBrush}" Width="18" Height="18" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
