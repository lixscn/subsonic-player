<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SubsonicPlayer.ViewModels"
             xmlns:models="using:SubsonicPlayer.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="SubsonicPlayer.Views.NowPlayingView"
             x:DataType="vm:NowPlayingViewModel">
    <Grid ColumnDefinitions="300,*,320" Margin="24">

        <!-- 左：封面 + 曲目信息 + 进度 -->
        <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Center">
            <Border Width="240" Height="240" CornerRadius="8" Background="{DynamicResource BgCardBrush}" ClipToBounds="True" HorizontalAlignment="Center">
                <Image Source="{Binding Playback.CurrentCover}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Spacing="6" HorizontalAlignment="Center" MaxWidth="280">
                <TextBlock Text="{Binding Playback.CurrentTitle}" FontSize="20" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Playback.CurrentSong.Artist}" Classes="wf-sub" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" Width="280" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Playback.PositionText}" Classes="wf-sub" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Margin="10,0" Minimum="0" Maximum="{Binding Playback.DurationSeconds, FallbackValue=1}" Value="{Binding Playback.PositionSeconds}"/>
                <TextBlock Grid.Column="2" Text="{Binding Playback.DurationText}" Classes="wf-sub" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- 中：歌词 -->
        <Border Grid.Column="1" Classes="wf-card" Padding="16" Margin="0,0,12,0">
            <Grid>
                <TextBlock Text="{Binding LyricsStatus}" Classes="wf-sub" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding HasLyricsStatus}"/>

                <!-- 非同步歌词 -->
                <ScrollViewer IsVisible="{Binding Lyrics.IsSynced, Converter={x:Static conv:BoolConverters.Not}, FallbackValue=False}">
                    <TextBlock Text="{Binding LyricsText}" TextWrapping="Wrap" LineHeight="26" FontSize="15" TextAlignment="Center"/>
                </ScrollViewer>

                <!-- 同步歌词 -->
                <ListBox ItemsSource="{Binding Lyrics.Lines}"
                         SelectedIndex="{Binding CurrentLineIndex}"
                         Background="Transparent"
                         IsVisible="{Binding Lyrics.IsSynced, FallbackValue=False}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="17"/>
                        </Style>
                        <Style Selector="ListBoxItem TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:LyricsLine">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" Padding="8,8"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右：播放队列 -->
        <Border Grid.Column="2" Classes="wf-card" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="播放队列" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Playback.Queue}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Song">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Padding="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
